# Copiar a .env y completar. Nunca subir .env al repo.

# Base de datos (local: docker compose up -d postgres)
DATABASE_URL=postgresql://aluvi:aluvi@localhost:5432/aluvi

# API
API_PORT=3001
API_URL=http://localhost:3001

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001

# Bot de WhatsApp (WAHA local: docker compose up -d waha)
WAHA_URL=http://localhost:3002
WAHA_API_KEY=
BOT_PORT=3003
# Números habilitados a cargar movimientos por el bot (separados por coma)
BOT_NUMEROS_AUTORIZADOS=

# IA
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
