{
  "name": "@aluvi/api",
  "version": "0.0.0",
  "private": true,
  "description": "API del sistema: expone la lógica de cada módulo a la web y al bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aluvi/shared": "workspace:*",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
